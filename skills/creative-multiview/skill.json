{
  "name": "creative.multiview",
  "version": "1.0.0",
  "label": "多视角与 3D 重建",
  "description": "生成九宫格多视角、自定义机位或从图片重建 3D。当用户提到九宫格、换机位、环绕视角、360 度看物体、图生 3D 或送入 Blender 时使用。",
  "author": "@nomi",
  "tools": [
    "read_canvas_state",
    "list_capability_recipes",
    "apply_capability_recipe",
    "handoff_model3d"
  ],
  "requiredProviders": ["image", "model3d"],
  "permissions": ["read-only", "create"],
  "inputs": [
    {
      "name": "source",
      "description": "画布中的清晰主体图片节点，以及期望的机位或 3D 用途。",
      "required": true
    }
  ],
  "examples": [
    {
      "title": "产品九宫格与 3D",
      "input": "把这张咖啡机做成九宫格，再重建 3D 并送进 Blender 导演台。"
    }
  ],
  "canvas": {
    "recipeIds": [
      "image.multiview.grid9",
      "image.multiview.custom",
      "image.multiview.reconstruct3d"
    ],
    "defaultRecipeId": "image.multiview.grid9"
  },
  "stages": [
    {
      "id": "inspect",
      "goal": "读取画布并确认唯一主体、遮挡、参考图质量与所需机位。",
      "tools": ["read_canvas_state", "list_capability_recipes"],
      "pause": true
    },
    {
      "id": "views",
      "goal": "用九宫格或自定义机位配方生成身份和几何一致的视角结果集合。",
      "tools": ["read_canvas_state", "apply_capability_recipe"],
      "dependsOn": ["inspect"],
      "pause": true,
      "modelPrefs": [{ "kind": "image" }]
    },
    {
      "id": "reconstruct",
      "goal": "在用户需要可环绕物体时，从清晰参考图生成可交接的 3D 模型。",
      "tools": ["read_canvas_state", "apply_capability_recipe"],
      "dependsOn": ["views"],
      "pause": true,
      "modelPrefs": [{ "kind": "model3d" }]
    },
    {
      "id": "handoff",
      "goal": "把选定 3D 结果无损送入 Scene3D 或 Blender Director，保留来源节点。",
      "tools": ["read_canvas_state", "handoff_model3d"],
      "dependsOn": ["reconstruct"],
      "pause": true
    }
  ]
}
