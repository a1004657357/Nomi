{
  "name": "workbench.cinematic-director",
  "version": "1.0.0",
  "label": "电影导演",
  "description": "在画布上按 Film Bible、ShotSpec、资产版本和生成预算分阶段推进电影项目。",
  "author": "@nomi",
  "tools": [
    "read_project_summary",
    "read_film_bible",
    "read_storyboard",
    "read_shot_spec",
    "read_asset_registry",
    "read_provider_capabilities",
    "read_task_status",
    "propose_film_bible_patch",
    "propose_storyboard_plan",
    "propose_shot_patch",
    "propose_generation_plan",
    "propose_timeline_assembly",
    "apply_film_bible_patch",
    "apply_storyboard_patch",
    "create_asset_records",
    "select_asset_revision",
    "archive_asset_revision",
    "place_assets_on_timeline",
    "submit_generation_intent",
    "cancel_provider_task"
  ],
  "requiredProviders": ["text"],
  "permissions": ["read-only", "create"],
  "canvas": {
    "recipeIds": []
  },
  "stages": [
    {
      "id": "project-contract",
      "goal": "读取现有项目并建立或修订 Film Bible；先提案，确认后再写入。",
      "tools": [
        "read_project_summary",
        "read_film_bible",
        "read_asset_registry",
        "read_storyboard",
        "propose_film_bible_patch",
        "apply_film_bible_patch"
      ],
      "pause": true,
      "modelPrefs": [{ "kind": "text" }]
    },
    {
      "id": "storyboard",
      "goal": "把项目事实落实为可执行分镜和资产记录，所有修改经结构化补丁确认。",
      "dependsOn": ["project-contract"],
      "tools": [
        "read_film_bible",
        "read_storyboard",
        "read_shot_spec",
        "read_asset_registry",
        "propose_storyboard_plan",
        "propose_shot_patch",
        "apply_storyboard_patch",
        "create_asset_records",
        "select_asset_revision",
        "archive_asset_revision"
      ],
      "pause": true,
      "modelPrefs": [{ "kind": "text" }]
    },
    {
      "id": "production",
      "goal": "按 Provider 能力、参考角色和预算形成生成计划；只有用户确认后才提交付费任务。",
      "dependsOn": ["storyboard"],
      "tools": [
        "read_storyboard",
        "read_shot_spec",
        "read_asset_registry",
        "read_provider_capabilities",
        "read_task_status",
        "propose_generation_plan",
        "submit_generation_intent",
        "cancel_provider_task"
      ],
      "pause": true,
      "modelPrefs": [{ "kind": "text" }]
    },
    {
      "id": "assemble",
      "goal": "检查任务结果，提案并确认分镜到时间线的确定性组装。",
      "dependsOn": ["production"],
      "tools": [
        "read_storyboard",
        "read_task_status",
        "propose_timeline_assembly",
        "place_assets_on_timeline"
      ],
      "pause": true,
      "modelPrefs": [{ "kind": "text" }]
    }
  ]
}
