{
  "name": "creative.mood-identity",
  "version": "1.0.0",
  "label": "5×5 情绪与身份保护",
  "description": "用能量、亲和度和表情强度生成身份一致的情绪版本。当用户提到情绪矩阵、5×5 表情、开心或冷淡程度、角色表演变化且不能换脸时使用。",
  "author": "@nomi",
  "tools": [
    "read_canvas_state",
    "list_capability_recipes",
    "apply_capability_recipe",
    "save_creative_resource"
  ],
  "requiredProviders": ["image"],
  "permissions": ["read-only", "create"],
  "inputs": [
    {
      "name": "portraitAndMood",
      "description": "清晰人物节点，以及目标能量、亲和度、表情强度或表演意图。",
      "required": true
    }
  ],
  "examples": [
    {
      "title": "克制但疏离",
      "input": "保持这个演员不变，生成低能量、高疏离、轻微克制不悦的版本。"
    }
  ],
  "canvas": {
    "recipeIds": ["portrait.mood"],
    "defaultRecipeId": "portrait.mood"
  },
  "stages": [
    {
      "id": "inspect",
      "goal": "读取人物素材，确认身份锚、基础表情和表演边界。",
      "tools": ["read_canvas_state", "list_capability_recipes"],
      "pause": true
    },
    {
      "id": "coordinates",
      "goal": "把自然语言表演意图映射为 0 到 4 的能量、亲和度与表情强度。",
      "tools": ["read_canvas_state"],
      "dependsOn": ["inspect"],
      "pause": true
    },
    {
      "id": "generate",
      "goal": "用 portrait.mood 生成身份一致的目标情绪新版本。",
      "tools": ["read_canvas_state", "apply_capability_recipe"],
      "dependsOn": ["coordinates"],
      "pause": true,
      "modelPrefs": [{ "kind": "image" }]
    },
    {
      "id": "save",
      "goal": "把用户确认的角色版本按需保存为 identity 资源。",
      "tools": ["read_canvas_state", "save_creative_resource"],
      "dependsOn": ["generate"],
      "pause": true
    }
  ]
}
