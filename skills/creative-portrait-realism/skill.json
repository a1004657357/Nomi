{
  "name": "creative.portrait-realism",
  "version": "1.0.0",
  "label": "人像真实化",
  "description": "在保护身份的前提下改善皮肤、光线、材质、清晰度和场景融合。当用户提到人像真实化、去塑料感、皮肤质感、光影融合或照片感时使用。",
  "author": "@nomi",
  "tools": [
    "read_canvas_state",
    "list_capability_recipes",
    "apply_capability_recipe",
    "save_creative_resource"
  ],
  "requiredProviders": ["image"],
  "permissions": ["read-only", "create"],
  "inputs": [
    {
      "name": "portrait",
      "description": "包含清晰面部的人像节点，以及希望改善的真实化维度。",
      "required": true
    }
  ],
  "examples": [
    {
      "title": "去除塑料皮肤",
      "input": "保持人物完全一致，只修复皮肤蜡感、光线不融合和过锐问题。"
    }
  ],
  "canvas": {
    "recipeIds": ["portrait.refine"],
    "defaultRecipeId": "portrait.refine"
  },
  "stages": [
    {
      "id": "inspect",
      "goal": "读取来源人像，识别身份锚、真实化问题和不可改变项。",
      "tools": ["read_canvas_state", "list_capability_recipes"],
      "pause": true
    },
    {
      "id": "refine",
      "goal": "用 portrait.refine 按用户确认的强度修复场景融合、光线、皮肤和材质。",
      "tools": ["read_canvas_state", "apply_capability_recipe"],
      "dependsOn": ["inspect"],
      "pause": true,
      "modelPrefs": [{ "kind": "image" }]
    },
    {
      "id": "identity-resource",
      "goal": "用户需要跨镜复用时，把选定人像保存为带来源信息的身份资源。",
      "tools": ["read_canvas_state", "save_creative_resource"],
      "dependsOn": ["refine"],
      "pause": true
    }
  ]
}
