{
  "name": "creative.video-look-effect",
  "version": "1.0.0",
  "label": "视频风格与效果",
  "description": "把视觉风格或动作效果保存为资源，应用到视频镜头并排入时间轴。当用户提到视频调色、统一质感、效果参考、粒子/变形/转场效果或时序风格一致时使用。",
  "author": "@nomi",
  "tools": [
    "read_canvas_state",
    "list_capability_recipes",
    "save_creative_resource",
    "apply_capability_recipe",
    "arrange_storyboard_to_timeline"
  ],
  "requiredProviders": ["video"],
  "permissions": ["read-only", "create"],
  "inputs": [
    {
      "name": "shotAndReference",
      "description": "目标镜头、风格或效果描述、可选参考媒体及来源许可。",
      "required": true
    }
  ],
  "examples": [
    {
      "title": "饮品冰雾效果",
      "input": "保存冰雾沿杯壁扩散的效果参考，应用到这个产品镜头并排到时间轴。"
    }
  ],
  "canvas": {
    "recipeIds": [
      "video.look.apply",
      "video.effect.reference",
      "video.edit.look",
      "video.edit.effect"
    ],
    "defaultRecipeId": "video.look.apply"
  },
  "stages": [
    {
      "id": "analyze",
      "goal": "读取镜头和参考，拆分视觉风格、动作因果、持续时间，并确认授权。",
      "tools": ["read_canvas_state", "list_capability_recipes"],
      "pause": true
    },
    {
      "id": "save",
      "goal": "把确认的风格或效果保存为带来源和商业使用信息的 CreativeResource。",
      "tools": ["read_canvas_state", "save_creative_resource"],
      "dependsOn": ["analyze"],
      "pause": true
    },
    {
      "id": "apply",
      "goal": "按源媒体类型选择图片驱动或视频转视频配方，生成时序稳定的新视频版本。",
      "tools": ["read_canvas_state", "apply_capability_recipe"],
      "dependsOn": ["save"],
      "pause": true,
      "modelPrefs": [{ "kind": "video" }]
    },
    {
      "id": "assemble",
      "goal": "用户选定视频版本后，按分镜顺序排入时间轴。",
      "tools": ["read_canvas_state", "arrange_storyboard_to_timeline"],
      "dependsOn": ["apply"],
      "pause": true,
      "modelPrefs": [{ "kind": "video" }]
    }
  ]
}
