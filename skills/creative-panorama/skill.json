{
  "name": "creative.panorama",
  "version": "1.0.0",
  "label": "360° 全景场景",
  "description": "生成严格 2:1 的等距柱状 360° 全景。当用户提到全景图、环境球、HDRI 构图、VR 场景、四周空间或导演台环境时使用。",
  "author": "@nomi",
  "tools": [
    "read_canvas_state",
    "list_capability_recipes",
    "apply_capability_recipe",
    "create_staging_reference"
  ],
  "requiredProviders": ["image"],
  "permissions": ["read-only", "create"],
  "inputs": [
    {
      "name": "sceneBrief",
      "description": "场景类型、空间关系、时间、光线与可选参考图。",
      "required": true
    }
  ],
  "examples": [
    {
      "title": "咖啡店环境球",
      "input": "生成一个下午靠窗咖啡店的 2:1 全景，供导演台摆机位。"
    }
  ],
  "canvas": {
    "recipeIds": ["scene.panorama.2to1"],
    "defaultRecipeId": "scene.panorama.2to1"
  },
  "stages": [
    {
      "id": "inspect",
      "goal": "读取现有场景素材，确认空间类型、地平线、入口、主要区域与用途。",
      "tools": ["read_canvas_state", "list_capability_recipes"],
      "pause": true
    },
    {
      "id": "spatial-plan",
      "goal": "在需要人物空间调度时先建立低成本站位参考，核对方位关系。",
      "tools": ["read_canvas_state", "create_staging_reference"],
      "dependsOn": ["inspect"],
      "pause": true
    },
    {
      "id": "generate",
      "goal": "用 scene.panorama.2to1 生成无缝、严格 2:1 的等距柱状全景。",
      "tools": ["read_canvas_state", "apply_capability_recipe"],
      "dependsOn": ["spatial-plan"],
      "pause": true,
      "modelPrefs": [{ "kind": "image" }]
    }
  ]
}
