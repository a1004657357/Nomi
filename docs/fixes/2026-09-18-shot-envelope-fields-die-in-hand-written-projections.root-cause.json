    "electron/shared/agentCapabilities/verbs/writeVerbs.ts",
    "electron/agentLane/laneVerbTransport.ts"
  ],
  "entry_points": [
    "electron/agentLane/laneVerbTransport.ts:draftShotToPlanShot",
    "electron/capabilityCore/mcpGenerationMultiShot.ts:shotEnvelope",
    "electron/capabilityCore/mcpGenerationMultiShot.ts:sealMultiShotFor",
    "electron/productionRun/productionGenerationOperationStore.ts:generationPlanProjection",
    "electron/productionRun/productionRunRepository.ts:createGenerationDraft",
    "electron/productionRun/multiShotCanvasLanding.ts:shotLabel",
