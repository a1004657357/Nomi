{
  "schema_version": 3,
  "id": "2026-09-19-generation-scope-and-dismissal",
  "problem_type": "Unbound spend intent, destructive dismissal and batch authority reuse",
  "symptom": "A three-shot request presents all 33 shots; dismissal destroys creative content; a later request cannot execute safely while retaining earlier jobs and their costs.",
  "direct_cause": "present drops shotIds; discard deletes nodes; confirmation lacks its displayed version; seal hardcodes attempt 1 and overwrites policy/ledger ceilings; observation requires the current plan contract; checkpoint and submission commands key only the Run or content.",
  "class_root": "A paid request has no atomically validated scope or lifecycle separate from retained creative content.",
  "affected_population": [
    "Internal lane and external MCP multi-shot requests",
    "Single and multi-shot card dismissal"
  ],
